generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql" // or "mongodb" / "mysql"
  url      = env("DATABASE_URL")
}

model GalleryItem {
  id        Int      @id @default(autoincrement())
  pageKey   String   // 👈 New Field (e.g., "chess", "robotics")
  category  String
  type      String
  src       String
  title     String
  location  String
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  pageKey   String   // 👈 New Field
  name      String
  role      String
  content   String
  rating    Int
  date      String
  createdAt DateTime @default(now())
}

model SuccessStory {
  id             Int      @id @default(autoincrement())
  pageKey        String   // 👈 New Field
  name           String
  role           String
  image          String
  videoThumbnail String
  quote          String
  story          String
  stats          String   
  createdAt      DateTime @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  pageKey     String   // 👈 New Field
  title       String
  category    String
  age         String
  description String
  features    String
  themeKey    String
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
}