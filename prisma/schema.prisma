generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// AUTHENTICATION & USER MODELS
// ===========================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum LeadStatus {
  PENDING
  CONTACTED
  CONVERTED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  phone         String
  password      String    // Hashed password
  dob           DateTime
  profilePhoto  String?
  address       String
  latitude      Float?
  longitude     Float?
  role          UserRole
  accountCreator String?
  gender         String?
  preferredLanguage String?   @default("English")
  securityQuestion String?
  securityAnswer   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacher       Teacher?
  student       Student?
  supportTickets SupportTicket[]
}

model Teacher {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications        String    // JSON string of certifications
  education             String
  experience            String
  subjects              String    // JSON string of subjects
  teachingMode          String?   // "Home Tutor", "Online Tutor", "At Centre" or JSON array
  expectedFee           Int?      // e.g., 1200
  feeType               String?   // "/hr" or "/month"
  classesOrAgeGroup     String?   // JSON string of classes/age groups
  qualificationLevel    String?   // Degree/PG/M.Phil/PhD/PostDoc
  qualificationName     String?   // BSc/BA/B.Com/B.Tech etc.
  achievements          String?   // Free-text achievements/awards
  achievementCertificate String?  // URL to achievement certificate image
  qualificationCertificate String? // URL to qualification certificate image
  identityProof          String?  // URL to identity proof document
  isApproved            Boolean   @default(false)
  approvedAt            DateTime?
  subscriptionStatus    String    @default("none") // none, trial, active, expired
  subscriptionEnd       DateTime?
  subscriptionPaymentId String?
  views                 Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  leads                 Lead[]
  classes               ScheduledClass[]
  earnings              TutorEarning[]
  progressReports       StudentProgressReport[]
  availabilities        TutorAvailability[]
}

model Student {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  String   // JSON string of interested subjects
  children  String?  // JSON string of children profiles
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads              Lead[]
  eventRegistrations EventRegistration[]
  classes            ScheduledClass[]
  progressReports    StudentProgressReport[]
}

model Lead {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  message    String?
  location   String?
  latitude   Float?
  longitude  Float?
  subject    String?
  classLevel String?
  mode       String?
  status     LeadStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ===========================================
// EXISTING CMS MODELS
// ===========================================

model Course {
  id          Int      @id @default(autoincrement())
  pageKey     String
  title       String
  category    String
  age         String
  description String
  features    String
  themeKey    String
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model GalleryItem {
  id        Int      @id @default(autoincrement())
  pageKey   String
  category  String
  type      String
  src       String
  title     String
  location  String
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  pageKey   String
  name      String
  role      String
  content   String
  rating    Int
  date      String
  createdAt DateTime @default(now())
}

model SuccessStory {
  id             Int      @id @default(autoincrement())
  pageKey        String
  name           String
  role           String
  image          String
  videoThumbnail String
  quote          String
  story          String
  stats          String
  createdAt      DateTime @default(now())
}

model Banner {
  id        Int      @id @default(autoincrement())
  pageKey   String   @unique // Matches "chess", "robotics", etc.
  imageUrl  String
  updatedAt DateTime @updatedAt
}

model Event {
  id                     Int      @id @default(autoincrement())
  slug                   String   @unique
  title                  String
  category               String   // tournament, workshop, seminar, exhibition, special
  date                   String
  time                   String
  endDate                String
  location               String
  address                String
  participants           String
  prize                  String
  description            String
  longDescription        String
  image                  String
  status                 String   @default("upcoming") // upcoming, ongoing, completed
  registrationFee        Int
  registrationFeeDisplay String
  features               String   // JSON array
  organizer              String
  contact                String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  registrations EventRegistration[]
}

model EventRegistration {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String
  age       String?
  status    String   @default("registered") // registered, confirmed, cancelled
  paymentId String?  // Razorpay payment ID
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, studentId])
}

model SubscriptionPlan {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int      // Amount in INR
  duration    Int      // Duration in days
  description String
  features    String   // JSON array of feature strings
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VerificationRequest {
  id         String   @id @default(cuid())
  identifier String   // Email
  token      String   // OTP
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  adminNote String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ScheduledClass {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     String
  date        String   // yyyy-mm-dd
  time        String   // e.g. 05:00 PM
  duration    String   // e.g. 1.5 hours
  meetLink    String?
  status      String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  classRate   Float?   // Custom rate specified during scheduling
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TutorEarning {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  amount      Float
  status      String    @default("PENDING") // PENDING, PAID
  description String
  payoutDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StudentProgressReport {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     String
  grade       String    // e.g. A, B, C or percentage
  attendance  Float     // Attendance percentage
  testScore   String?   // Optional test score info
  behavior    String    // Excellent, Good, Fair, Needs Improvement
  comments    String    @db.Text
  reportDate  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TutorAvailability {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek   Int       // 0 (Sunday) to 6 (Saturday)
  startTime   String    // e.g. "09:00"
  endTime     String    // e.g. "17:00"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}